{
  "name": "@diceforge-sdk/assets-forge",
  "version": "0.4.0",
  "description": "The first-party DiceForge die set: d4-d20 models, a two-faced coin, and texture atlases in five colours, resolved to URLs your bundler emits.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephanTTM/DiceForgeSDK.git",
    "directory": "packages/assets-forge"
  },
  "homepage": "https://github.com/StephanTTM/DiceForgeSDK#readme",
  "bugs": "https://github.com/StephanTTM/DiceForgeSDK/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./forge/*": "./forge/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "forge"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dice",
    "3d",
    "gltf",
    "assets",
    "models",
    "textures",
    "tabletop"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@diceforge-sdk/renderer-web": "^0.4.0"
  }
}
