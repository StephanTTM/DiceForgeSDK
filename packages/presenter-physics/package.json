{
  "name": "@diceforge-sdk/presenter-physics",
  "version": "0.4.0",
  "description": "Physics motion for DiceForge dice: simulates a roll, then remaps each die so the already-resolved face lands where the simulation put it.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephanTTM/DiceForgeSDK.git",
    "directory": "packages/presenter-physics"
  },
  "homepage": "https://github.com/StephanTTM/DiceForgeSDK#readme",
  "bugs": "https://github.com/StephanTTM/DiceForgeSDK/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dice",
    "physics",
    "cannon-es",
    "3d",
    "diceforge",
    "tabletop"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "cannon-es": "^0.20.0"
  },
  "peerDependencies": {
    "@diceforge-sdk/renderer-web": "^0.4.0"
  },
  "devDependencies": {
    "@diceforge-sdk/renderer-web": "^0.4.0"
  }
}
