{
  "name": "@diceforge-sdk/renderer-web",
  "version": "0.4.0",
  "description": "Browser presenter for DiceForge: Three.js 3D dice with outcome-first animation, DOM fallback, reduced-motion support, and accessible announcements.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephanTTM/DiceForgeSDK.git",
    "directory": "packages/renderer-web"
  },
  "homepage": "https://github.com/StephanTTM/DiceForgeSDK#readme",
  "bugs": "https://github.com/StephanTTM/DiceForgeSDK/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dice",
    "3d",
    "threejs",
    "webgl",
    "renderer",
    "tabletop"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@diceforge-sdk/core": "^0.4.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@diceforge-sdk/testing": "^0.4.0",
    "@types/three": "^0.182.0"
  }
}
