{
  "name": "@diceforge-sdk/testing",
  "version": "0.3.0",
  "description": "Conformance tests for DiceForge plugins: check that a presenter honors the InteractionPresenter contract it declares.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephanTTM/DiceForgeSDK.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/StephanTTM/DiceForgeSDK#readme",
  "bugs": "https://github.com/StephanTTM/DiceForgeSDK/issues",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dice",
    "diceforge",
    "conformance",
    "contract-tests",
    "plugin",
    "testing"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@diceforge-sdk/core": "^0.3.0"
  },
  "devDependencies": {
    "@diceforge-sdk/core": "^0.3.0"
  }
}
