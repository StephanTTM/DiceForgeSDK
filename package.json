{
  "name": "diceforge-sdk",
  "private": true,
  "version": "0.0.0",
  "description": "DiceForge SDK monorepo — offline-first, renderer-agnostic dice and coin-flip engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p packages/core/tsconfig.build.json",
    "example": "npm run build && node examples/headless/main.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
