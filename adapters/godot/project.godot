; Engine configuration file.
; Godot 4 test-host project for the DiceForge addon. The addon itself is
; everything under addons/diceforge; this project exists to run the
; conformance vectors against it.
config_version=5

[application]

config/name="DiceForge Godot Adapter"
run/main_scene="res://tests/conformance.tscn"
config/features=PackedStringArray("4.7")
