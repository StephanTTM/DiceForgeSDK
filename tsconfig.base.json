{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    // Published packages ship `dist` and not `src`, so a map that merely points
    // at "../src/*.ts" resolves to nothing in a consumer's project — some
    // bundlers warn, and none of them can show the source. Inlining the text
    // makes each map self-contained, whatever a bundler does with paths.
    "inlineSources": true,
    "skipLibCheck": true
  }
}
